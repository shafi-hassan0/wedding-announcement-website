# Copy this file to .env and fill in real values. .env is gitignored.

# The code printed on the invitation. Upper and lower case are treated the same.
INVITE_CODE=

# Password for the /admin page. Use a long random one.
ADMIN_PASSWORD=

# Signs the cookies that remember guests. Generate with: openssl rand -hex 32
# Changing it later signs every guest out.
SESSION_SECRET=

# Email notifications through EmailJS (optional). Leave blank to skip emails;
# every RSVP, note and message still shows on the /admin page.
# Use a template with {{subject}}, {{message}}, {{from_name}} and {{reply_to}},
# and put both of your addresses in the template's "To Email" field.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
