# The backend (server/). It has no npm dependencies, so there is nothing to install or build.
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    DB_PATH=/data/wedding.db
COPY package.json ./
COPY server ./server
# The invitation maker is served by the backend, to signed-in admins only.
COPY invitation ./invitation
# The database lives in a volume mounted at /data; make sure the unprivileged user owns it.
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "--disable-warning=ExperimentalWarning", "server/index.js"]
